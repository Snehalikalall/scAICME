@article{reedSinglecellAtlasEnables2024,
  title = {A Single-Cell Atlas Enables Mapping of Homeostatic Cellular Shifts in the Adult Human Breast},
  author = {Reed, Austin D. and Pensa, Sara and Steif, Adi and Stenning, Jack and Kunz, Daniel J. and Porter, Linsey J. and Hua, Kui and He, Peng and Twigger, Alecia-Jane and Siu, Abigail J. Q. and Kania, Katarzyna and {Barrow-McGee}, Rachel and Goulding, Iain and Gomm, Jennifer J. and Speirs, Valerie and Jones, J. Louise and Marioni, John C. and Khaled, Walid T.},
  year = 2024,
  month = apr,
  journal = {Nature Genetics},
  volume = {56},
  number = {4},
  pages = {652--662},
  publisher = {Nature Publishing Group},
  issn = {1546-1718},
  doi = {10.1038/s41588-024-01688-9},
  urldate = {2026-10-27},
  abstract = {Here we use single-cell RNA sequencing to compile a human breast cell atlas assembled from 55 donors that had undergone reduction mammoplasties or risk reduction mastectomies. From more than 800,000 cells we identified 41 cell subclusters across the epithelial, immune and stromal compartments. The contribution of these different clusters varied according to the natural history of the tissue. Age, parity and germline mutations, known to modulate the risk of developing breast cancer, affected the homeostatic cellular state of the breast in different ways. We found that immune cells from BRCA1 or BRCA2 carriers had a distinct gene expression signature indicative of potential immune exhaustion, which was validated by immunohistochemistry. This suggests that immune-escape mechanisms could manifest in non-cancerous tissues very early during tumor initiation. This atlas is a rich resource that can be used to inform novel approaches for early detection and prevention of breast cancer.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Ageing,Bioinformatics,Breast cancer}
}


@article{reynoldsDevelopmentalCellPrograms2021,
  title = {Developmental Cell Programs Are Co-Opted in Inflammatory Skin Disease},
  author = {Reynolds, Gary and Vegh, Peter and Fletcher, James and Poyner, Elizabeth F. M. and Stephenson, Emily and Goh, Issac and Botting, Rachel A. and Huang, Ni and Olabi, Bayanne and Dubois, Anna and Dixon, David and Green, Kile and Maunder, Daniel and Engelbert, Justin and Efremova, Mirjana and Pola{\'n}ski, Krzysztof and Jardine, Laura and Jones, Claire and Ness, Thomas and Horsfall, Dave and McGrath, Jim and Carey, Christopher and Popescu, Dorin-Mirel and Webb, Simone and Wang, Xiao-nong and Sayer, Ben and Park, Jong-Eun and Negri, Victor A. and Belokhvostova, Daria and Lynch, Magnus D. and McDonald, David and Filby, Andrew and Hagai, Tzachi and Meyer, Kerstin B. and Husain, Akhtar and Coxhead, Jonathan and {Vento-Tormo}, Roser and Behjati, Sam and Lisgo, Steven and Villani, Alexandra-Chlo{\'e} and Bacardit, Jaume and Jones, Philip H. and O'Toole, Edel A. and Ogg, Graham S. and Rajan, Neil and Reynolds, Nick J. and Teichmann, Sarah A. and Watt, Fiona M. and Haniffa, Muzlifah},
  year = 2021,
  month = jan,
  journal = {Science},
  volume = {371},
  number = {6527},
  pages = {eaba6500},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.aba6500},
  urldate = {2026-10-25},
  abstract = {The skin confers biophysical and immunological protection through a complex cellular network established early in embryonic development. We profiled the transcriptomes of more than 500,000 single cells from developing human fetal skin, healthy adult skin, and adult skin with atopic dermatitis and psoriasis. We leveraged these datasets to compare cell states across development, homeostasis, and disease. Our analysis revealed an enrichment of innate immune cells in skin during the first trimester and clonal expansion of disease-associated lymphocytes in atopic dermatitis and psoriasis. We uncovered and validated in situ a reemergence of prenatal vascular endothelial cell and macrophage cellular programs in atopic dermatitis and psoriasis lesional skin. These data illustrate the dynamism of cutaneous immunity and provide opportunities for targeting pathological developmental programs in inflammatory skin diseases.}
}


